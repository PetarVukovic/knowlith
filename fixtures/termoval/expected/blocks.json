[
  {
    "name": "Biljeske-sastanak-2026-01.txt",
    "kind": "text",
    "verbatim": true,
    "text_sha256": "764026abe40e8c44992f68a408043f3ce6a802e5e7d428250c5657028151adc8",
    "columns": null,
    "blocks": [
      {
        "locator": "¶1",
        "kind": "paragraph",
        "start_byte": 0,
        "end_byte": 36,
        "text": "Sastanak prodaje, 15. sijecnja 2026."
      },
      {
        "locator": "¶2",
        "kind": "listitem",
        "start_byte": 38,
        "end_byte": 95,
        "text": "- Cjenik 2026 objavljen, stari cjenik povucen iz upotrebe"
      },
      {
        "locator": "¶3",
        "kind": "listitem",
        "start_byte": 96,
        "end_byte": 151,
        "text": "- Popust ostaje 5%, prag prometa podignut na 20.000 EUR"
      },
      {
        "locator": "¶4",
        "kind": "listitem",
        "start_byte": 152,
        "end_byte": 198,
        "text": "- Avans 40% za radove iznad 5.000 EUR - ostaje"
      },
      {
        "locator": "¶5",
        "kind": "listitem",
        "start_byte": 199,
        "end_byte": 253,
        "text": "- Broj krugova izmjena ponude: dva, treci se naplacuje"
      },
      {
        "locator": "¶6",
        "kind": "listitem",
        "start_byte": 254,
        "end_byte": 303,
        "text": "- Hotel Adriatic: ponuda poslana, ceka se odgovor"
      },
      {
        "locator": "¶7",
        "kind": "listitem",
        "start_byte": 304,
        "end_byte": 349,
        "text": "- Pekara Klas: bez popusta, ne ispunjava prag"
      },
      {
        "locator": "¶8",
        "kind": "paragraph",
        "start_byte": 351,
        "end_byte": 382,
        "text": "Sljedeci sastanak: 12. veljace."
      }
    ]
  },
