        "end_byte": 75,
        "text": "Datum primopredaje: ____________"
      },
      {
        "locator": "§1.1",
        "kind": "heading",
        "start_byte": 77,
        "end_byte": 92,
        "text": "Ugovorne strane"
      },
      {
        "locator": "§1.1 ¶1",
        "kind": "paragraph",
        "start_byte": 94,
        "end_byte": 128,
        "text": "Izvođač: Termoval d.o.o., Zagreb"
