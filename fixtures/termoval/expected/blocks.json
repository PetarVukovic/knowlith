  {
    "name": "Jamstveni-uvjeti.pdf",
    "kind": "pdf",
    "verbatim": false,
    "text_sha256": "04b813973ee75e9200355a734d3a4703eca94f4fb6517625ad932825d6007a3e",
    "columns": null,
    "blocks": [
      {
        "locator": "page 1, ¶1",
        "kind": "paragraph",
        "start_byte": 0,
        "end_byte": 16,
        "text": "Jamstveni uvjeti"
      },
      {
        "locator": "page 1, ¶2",
        "kind": "paragraph",
        "start_byte": 18,
        "end_byte": 64,
        "text": "Termoval d.o.o. - vrijedi od 1. sijecnja 2026."
      },
      {
        "locator": "page 1, ¶3",
        "kind": "paragraph",
        "start_byte": 66,
        "end_byte": 134,
        "text": "1. Jamstveni rok na ugradnju iznosi 24 mjeseca od dana primopredaje."
      },
      {
        "locator": "page 1, ¶4",
        "kind": "paragraph",
        "start_byte": 136,
        "end_byte": 202,
        "text": "2. Jamstveni rok na opremu odreduje proizvodac opreme i naveden je"
      },
      {
        "locator": "page 1, ¶5",
        "kind": "paragraph",
        "start_byte": 204,
        "end_byte": 245,
        "text": "u jamstvenom listu koji se predaje kupcu."
      },
      {
        "locator": "page 1, ¶6",
        "kind": "paragraph",
        "start_byte": 247,
        "end_byte": 314,
        "text": "3. Jamstvo vrijedi uz uvjet redovnog godisnjeg servisa koji obavlja"
      },
      {
        "locator": "page 1, ¶7",
        "kind": "paragraph",
        "start_byte": 316,
        "end_byte": 348,
        "text": "ovlasteni servis Termoval d.o.o."
      },
      {
        "locator": "page 2, ¶1",
        "kind": "paragraph",
        "start_byte": 350,
        "end_byte": 372,
        "text": "Sto jamstvo ne pokriva"
      },
      {
        "locator": "page 2, ¶2",
        "kind": "paragraph",
        "start_byte": 374,
        "end_byte": 414,
        "text": "- kvarove nastale nepravilnim rukovanjem"
      },
      {
        "locator": "page 2, ¶3",
        "kind": "paragraph",
        "start_byte": 416,
        "end_byte": 471,
        "text": "- kvarove nastale izostankom redovnog godisnjeg servisa"
      },
      {
        "locator": "page 2, ¶4",
        "kind": "paragraph",
        "start_byte": 473,
        "end_byte": 529,
        "text": "- ostecenja nastala radovima trecih osoba na instalaciji"
      },
      {
        "locator": "page 2, ¶5",
        "kind": "paragraph",
        "start_byte": 531,
        "end_byte": 583,
        "text": "- potrosni materijal, filtere i sredstva za ciscenje"
      },
      {
        "locator": "page 2, ¶6",
        "kind": "paragraph",
        "start_byte": 585,
        "end_byte": 651,
        "text": "Reklamacija se podnosi pisanim putem u roku od 8 dana od uocavanja"
      },
      {
        "locator": "page 2, ¶7",
        "kind": "paragraph",
        "start_byte": 653,
        "end_byte": 692,
        "text": "nedostatka, na adresu sjedista drustva."
      }
    ]
  },
  {
    "name": "Opci-uvjeti-poslovanja-2025-STARO.docx",
    "kind": "docx",
    "verbatim": false,
    "text_sha256": "6c0e0ef2c595e880167545591dbff75c3667ef8fbcc833abf08238ebd83ebe78",
    "columns": null,
    "blocks": [
      {
        "locator": "§1",
        "kind": "heading",
        "start_byte": 0,
        "end_byte": 23,
        "text": "Opći uvjeti poslovanja"
      },
      {
        "locator": "§1 ¶1",
        "kind": "paragraph",
        "start_byte": 25,
        "end_byte": 79,
        "text": "Termoval d.o.o., Zagreb. Vrijede od 1. siječnja 2025."
      },
      {
        "locator": "§1.1",
        "kind": "heading",
        "start_byte": 81,
        "end_byte": 88,
        "text": "Popusti"
      },
      {
        "locator": "§1.1 ¶1",
        "kind": "paragraph",
        "start_byte": 90,
        "end_byte": 226,
        "text": "Popust od 8% odobrava se stalnim kupcima, odnosno kupcima koji su u prethodnih dvanaest mjeseci ostvarili promet veći od 15.000,00 EUR."
      },
      {
        "locator": "§1.2",
        "kind": "heading",
        "start_byte": 228,
        "end_byte": 237,
        "text": "Plaćanje"
      },
      {
        "locator": "§1.2 ¶1",
        "kind": "paragraph",
        "start_byte": 239,
        "end_byte": 290,
        "text": "Rok plaćanja je 30 dana od dana izdavanja računa."
      },
      {
        "locator": "§1.3",
        "kind": "heading",
        "start_byte": 292,
        "end_byte": 299,
        "text": "Jamstvo"
      },
      {
        "locator": "§1.3 ¶1",
        "kind": "paragraph",
        "start_byte": 301,
        "end_byte": 366,
        "text": "Jamstveni rok na ugradnju iznosi 12 mjeseci od dana primopredaje."
      }
    ]
  },
  {
    "name": "Opci-uvjeti-poslovanja-2026.docx",
    "kind": "docx",
    "verbatim": false,
    "text_sha256": "6132c7319c76b97545e11251f06e18b31542634699080ac57a54a4ab4f7015a1",
    "columns": null,
    "blocks": [
      {
        "locator": "§1",
        "kind": "heading",
        "start_byte": 0,
        "end_byte": 23,
        "text": "Opći uvjeti poslovanja"
      },
      {
        "locator": "§1 ¶1",
        "kind": "paragraph",
        "start_byte": 25,
        "end_byte": 96,
        "text": "Termoval d.o.o., Zagreb, OIB 12345678901. Vrijede od 1. siječnja 2026."
      },
      {
        "locator": "§1.1",
        "kind": "heading",
        "start_byte": 98,
        "end_byte": 104,
        "text": "Cijene"
      },
      {
        "locator": "§1.1 ¶1",
        "kind": "paragraph",
        "start_byte": 106,
        "end_byte": 156,
        "text": "Sve cijene u ovom dokumentu iskazane su bez PDV-a."
      },
      {
        "locator": "§1.1 ¶2",
        "kind": "paragraph",
        "start_byte": 158,
        "end_byte": 317,
        "text": "Cijene vrijede za isporuku na području Grada Zagreba i Zagrebačke županije. Za isporuke izvan tog područja zaračunava se prijevoz prema važećem cjeniku."
      },
      {
        "locator": "§1.2",
        "kind": "heading",
        "start_byte": 319,
        "end_byte": 326,
        "text": "Popusti"
      },
      {
        "locator": "§1.2 ¶1",
        "kind": "paragraph",
        "start_byte": 328,
        "end_byte": 464,
        "text": "Popust od 5% odobrava se stalnim kupcima, odnosno kupcima koji su u prethodnih dvanaest mjeseci ostvarili promet veći od 20.000,00 EUR."
      },
      {
        "locator": "§1.2 ¶2",
        "kind": "paragraph",
        "start_byte": 466,
        "end_byte": 546,
        "text": "Popust veći od 10% odobrava isključivo voditelj prodaje, uz pisanu suglasnost."
      },
      {
        "locator": "§1.3",
        "kind": "heading",
        "start_byte": 548,
        "end_byte": 554,
        "text": "Ponude"
      },
      {
        "locator": "§1.3 ¶1",
        "kind": "paragraph",
        "start_byte": 556,
        "end_byte": 647,
        "text": "Ponuda vrijedi 14 dana od datuma izdavanja, osim ako je u samoj ponudi navedeno drugačije."
      },
      {
        "locator": "§1.3 ¶2",
        "kind": "paragraph",
        "start_byte": 649,
        "end_byte": 761,
        "text": "Broj krugova izmjena ponude ograničen je na dva. Svaka daljnja izmjena naplaćuje se prema satnici projektanta."
      },
      {
        "locator": "§1.4",
        "kind": "heading",
        "start_byte": 763,
        "end_byte": 772,
        "text": "Plaćanje"
      },
      {
        "locator": "§1.4 ¶1",
        "kind": "paragraph",
        "start_byte": 774,
        "end_byte": 825,
        "text": "Rok plaćanja je 15 dana od dana izdavanja računa."
      },
      {
        "locator": "§1.4 ¶2",
        "kind": "paragraph",
        "start_byte": 827,
        "end_byte": 933,
        "text": "Za radove čija vrijednost prelazi 5.000,00 EUR naplaćuje se avans u iznosu od 40% ugovorene vrijednosti."
      },
      {
        "locator": "§1.5",
        "kind": "heading",
        "start_byte": 935,
        "end_byte": 942,
        "text": "Jamstvo"
      },
      {
        "locator": "§1.5 ¶1",
        "kind": "paragraph",
        "start_byte": 944,
        "end_byte": 1009,
        "text": "Jamstveni rok na ugradnju iznosi 24 mjeseca od dana primopredaje."
      },
      {
        "locator": "§1.5 ¶2",
        "kind": "paragraph",
        "start_byte": 1011,
        "end_byte": 1113,
        "text": "Jamstvo ne pokriva kvarove nastale nepravilnim rukovanjem niti izostankom redovnog godišnjeg servisa."
      },
      {
        "locator": "§1.6",
        "kind": "heading",
        "start_byte": 1115,
        "end_byte": 1121,
        "text": "Servis"
      },
      {
        "locator": "§1.6 ¶1",
        "kind": "paragraph",
        "start_byte": 1123,
        "end_byte": 1202,
        "text": "Vrijeme izlaska na teren po prijavi kvara iznosi 24 sata za ugovorne korisnike."
      }
    ]
  },
